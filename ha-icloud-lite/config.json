{
  "name": "iCloud Lite",
  "version": "2.9.0",
  "slug": "icloud_lite",
  "image": "ghcr.io/jonathangibson98/{arch}-addon-icloud_lite",
  "description": "Track Apple devices from multiple iCloud accounts via MQTT",
  "url": "https://github.com/jonathangibson98/my-home-assistant-apps",
  "arch": [
    "aarch64",
    "amd64"
  ],
  "init": false,
  "ingress": true,
  "panel_icon": "mdi:cellphone-marker",
  "panel_title": "iCloud Lite",
  "services": [
    "mqtt:want"
  ],
  "homeassistant_api": true,
  "options": {
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": "",
    "log_level": "info",
    "log_pyicloud": false,
    "wallpaper": "",
    "ai_task_entity": ""
  },
  "schema": {
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?",
    "log_level": "list(debug|info|warning|error)?",
    "log_pyicloud": "bool?",
    "wallpaper": "str?",
    "ai_task_entity": "str?"
  }
}
