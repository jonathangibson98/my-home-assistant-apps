{
  "name": "iCloud Lite",
  "version": "2.2.0",
  "slug": "icloud_lite",
  "description": "Track Apple devices from multiple iCloud accounts via MQTT",
  "url": "https://github.com/jonathangibson98/my-home-assistant-apps",
  "arch": ["aarch64", "amd64"],
  "startup": "application",
  "boot": "auto",
  "init": false,
  "ingress": true,
  "ingress_port": 8099,
  "panel_icon": "mdi:cellphone-marker",
  "panel_title": "iCloud Lite",
  "services": ["mqtt:want"],
  "options": {
    "mqtt_host": "",
    "mqtt_port": 1883,
    "mqtt_username": "",
    "mqtt_password": ""
  },
  "schema": {
    "mqtt_host": "str?",
    "mqtt_port": "port?",
    "mqtt_username": "str?",
    "mqtt_password": "password?"
  }
}
